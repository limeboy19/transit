.venv/
__pycache__/
*.pyc
preview*.png
autoupdate.log
.DS_Store

# Your real config holds API keys — keep it OUT of git so it's never committed
# and so the auto-update `git reset --hard` can't clobber it. Ship
# config.example.json as the template instead.
config.json

# Azure service principal creds (AZURE_* env vars) — never commit.
.env
*.env

# NJ Transit daily token caches (auto-managed; protect the mint rate-limit)
.njt_token.json
.njtbus_token.json

# runtime error log (see /health)
error.log
